@@ -0,0 +1,40 @@
+import { Body, Controller, Post, ValidationPipe } from "@nestjs/common";
+import {
+  ApiConflictResponse,
+  ApiCreatedResponse,
+  ApiOperation,
+  ApiTags,
+} from "@nestjs/swagger";
+import { CreateMarryTestResultDto } from "./marry-test.dto";
+import { MarryTestService } from "./marry-test.service";
+
+@ApiTags("marry-test")
+@Controller("marry-test")
+export class MarryTestController {
+  constructor(private readonly service: MarryTestService) {}
+
+  @Post("results")
+  @ApiOperation({
+    summary: "익명 결혼 성향 결과 저장",
+    description:
+      "서버에서 재계산합니다. 같은 submissionId와 답변으로 재요청하면 같은 결과를 반환합니다.",
+  })
+  @ApiCreatedResponse({
+    description: "저장 확인: id, submissionId, quizVersion, result, createdAt",
+  })
+  @ApiConflictResponse({
+    description: "같은 submissionId에 서로 다른 답변을 제출함",
+  })
+  create(
+    @Body(
+      new ValidationPipe({
+        transform: true,
+        whitelist: true,
+        forbidNonWhitelisted: true,
+      }),
+    )
+    dto: CreateMarryTestResultDto,
+  ) {
+    return this.service.create(dto);
+  }
+}
