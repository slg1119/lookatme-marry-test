@@ -0,0 +1,129 @@
+import { randomUUID } from "node:crypto";
+import { INestApplication } from "@nestjs/common";
+import { Test } from "@nestjs/testing";
+import { MikroOrmModule } from "@mikro-orm/nestjs";
+import { MikroORM, PostgreSqlDriver } from "@mikro-orm/postgresql";
+import { Migrator } from "@mikro-orm/migrations";
+import { Migration20261026170000 } from "../../migrations/Migration20261026170000";
+import { MarryTestModule } from "./marry-test.module";
+import { MarryTestResult } from "./entities/marry-test-result.entity";
+
+describe("MarryTest HTTP + PostgreSQL", () => {
+  let app: INestApplication;
+  let orm: MikroORM;
+  let origin: string;
+  const clientUrl =
+    process.env.MARRY_TEST_DATABASE_URL ??
+    "postgresql://marry_test:marry_test_local@127.0.0.1:55478/marry_test_integration";
+  const url = new URL(clientUrl);
+  if (
+    !["127.0.0.1", "localhost"].includes(url.hostname) ||
+    url.pathname !== "/marry_test_integration"
+  ) {
+    throw new Error(
+      "Integration tests require the dedicated local marry_test_integration database.",
+    );
+  }
+  const payload = () => ({
+    submissionId: randomUUID(),
+    quizVersion: "marry-v1",
+    answers: Array(12).fill(0),
+  });
+  const post = (body: unknown) =>
+    fetch(`${origin}/marry-test/results`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      imports: [
+        MikroOrmModule.forRoot({
+          driver: PostgreSqlDriver,
+          clientUrl,
+          entities: [MarryTestResult],
+          extensions: [Migrator],
+          debug: false,
+          migrations: { migrationsList: [Migration20261026170000] },
+        }),
+        MarryTestModule,
+      ],
+    }).compile();
+    app = module.createNestApplication();
+    await app.init();
+    orm = app.get(MikroORM);
+    await orm.getMigrator().up();
+    await app.listen(0, "127.0.0.1");
+    origin = await app.getUrl();
+  });
+  afterAll(async () => {
+    if (orm) await orm.getMigrator().down();
+    if (app) await app.close();
+  });
+
+  it("persists answers, version and independently calculated scores in PostgreSQL", async () => {
+    const body = payload();
+    body.answers = [...Array(6).fill(0), ...Array(6).fill(3)];
+    const response = await post(body);
+    expect(response.status).toBe(201);
+    const saved = await response.json();
+    expect(saved.result).toEqual({
+      profileId: "everyday-soulmate",
+      self: { pace: -100, closeness: -100, care: -100 },
+      partner: { pace: 100, closeness: 100, care: 100 },
+    });
+    const row = await orm.em
+      .fork()
+      .findOneOrFail(MarryTestResult, { id: saved.id });
+    expect(row.answers).toEqual(body.answers);
+    expect(row.quizVersion).toBe("marry-v1");
+    expect(row.submissionId).toBe(body.submissionId);
+    expect(row.createdAt.toISOString()).toBe(saved.createdAt);
+  });
+  it("deduplicates concurrent retries across separate requests", async () => {
+    const body = payload();
+    const replies = await Promise.all(
+      Array.from({ length: 12 }, () => post(body)),
+    );
+    expect(replies.every((r) => r.status === 201)).toBe(true);
+    const rows = await Promise.all(replies.map((r) => r.json()));
+    expect(new Set(rows.map((r) => r.id)).size).toBe(1);
+    expect(
+      await orm.em
+        .fork()
+        .count(MarryTestResult, { submissionId: body.submissionId }),
+    ).toBe(1);
+  });
+  it("rejects reuse of a submission key with changed answers without overwriting", async () => {
+    const body = payload();
+    await post(body);
+    expect((await post({ ...body, answers: Array(12).fill(3) })).status).toBe(
+      409,
+    );
+    const row = await orm.em
+      .fork()
+      .findOneOrFail(MarryTestResult, { submissionId: body.submissionId });
+    expect(row.answers).toEqual(Array(12).fill(0));
+  });
+  it.each([
+    { answers: Array(11).fill(0) },
+    { answers: Array(13).fill(0) },
+    { answers: [-1, ...Array(11).fill(0)] },
+    { answers: [4, ...Array(11).fill(0)] },
+    { answers: [null, ...Array(11).fill(0)] },
+    { answers: ["1", ...Array(11).fill(0)] },
+    { answers: [0.5, ...Array(11).fill(0)] },
+    { quizVersion: "marry-v2" },
+    { submissionId: "not-a-uuid" },
+    { profileId: "forged" },
+    { userId: randomUUID() },
+  ])("rejects invalid/forged payload %# without writing", async (patch) => {
+    const before = await orm.em.fork().count(MarryTestResult, {});
+    expect((await post({ ...payload(), ...patch })).status).toBe(400);
+    expect(await orm.em.fork().count(MarryTestResult, {})).toBe(before);
+  });
+  it("does not publish stored answers through a public read endpoint", async () => {
+    expect((await fetch(`${origin}/marry-test/results`)).status).toBe(404);
+  });
+});
