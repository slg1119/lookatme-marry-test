+import { Migration } from "@mikro-orm/migrations";
+
+export class Migration20261026170000 extends Migration {
+  async up(): Promise<void> {
+    this.addSql(`create table "marry_test_results" (
+      "id" uuid not null default gen_random_uuid(),
+      "submission_id" uuid not null,
+      "quiz_version" varchar(32) not null,
+      "answers" jsonb not null,
+      "profile_id" varchar(64) not null,
+      "self_scores" jsonb not null,
+      "partner_scores" jsonb not null,
+      "created_at" timestamptz not null default now(),
+      "updated_at" timestamptz not null default now(),
+      constraint "marry_test_results_pkey" primary key ("id"),
+      constraint "marry_test_results_submission_id_unique" unique ("submission_id"),
+      constraint "marry_test_results_answers_shape" check (jsonb_typeof(answers) = 'array' and jsonb_array_length(answers) = 12)
+    );`);
+    this.addSql(
+      'create index "marry_test_results_created_at_index" on "marry_test_results" ("created_at");',
+    );
+  }
+
+  async down(): Promise<void> {
+    this.addSql('drop table if exists "marry_test_results";');
+  }
+}
