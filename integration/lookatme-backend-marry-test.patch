+import { BadRequestException } from "@nestjs/common";
+import { QUIZ_CONTRACT } from "./quiz-contract";
+
+export type AxisScores = { pace: number; closeness: number; care: number };
+export type MarryTestScore = {
+  profileId: string;
+  self: AxisScores;
+  partner: AxisScores;
+};
+
+export function scoreMarryTest(
+  version: string,
+  answers: number[],
+): MarryTestScore {
+  if (
+    version !== QUIZ_CONTRACT.version ||
+    !Array.isArray(answers) ||
+    answers.length !== 12
+  ) {
+    throw new BadRequestException("테스트 버전과 12개 답변을 확인해 주세요.");
+  }
+  const scores = {
+    self: { pace: 0, closeness: 0, care: 0 },
+    partner: { pace: 0, closeness: 0, care: 0 },
+  };
+  const max = {
+    self: { pace: 0, closeness: 0, care: 0 },
+    partner: { pace: 0, closeness: 0, care: 0 },
+  };
+  QUIZ_CONTRACT.questions.forEach((question, index) => {
+    const answer = answers[index];
+    if (
+      !Number.isInteger(answer) ||
+      answer < 0 ||
+      answer >= question.scores.length
+    ) {
+      throw new BadRequestException("답변은 0부터 3 사이의 정수여야 합니다.");
+    }
+    scores[question.perspective][question.axis] += question.scores[answer];
+    max[question.perspective][question.axis] += Math.max(
+      ...question.scores.map(Math.abs),
+    );
+  });
+  for (const perspective of ["self", "partner"] as const) {
+    for (const axis of ["pace", "closeness", "care"] as const) {
+      scores[perspective][axis] = Math.round(
+        (scores[perspective][axis] / max[perspective][axis]) * 100,
+      );
+    }
+  }
+  const profileIndex =
+    (scores.self.pace > 0 ? 4 : 0) +
+    (scores.self.closeness > 0 ? 2 : 0) +
+    (scores.self.care > 0 ? 1 : 0);
+  return { profileId: QUIZ_CONTRACT.profileIds[profileIndex], ...scores };
+}
