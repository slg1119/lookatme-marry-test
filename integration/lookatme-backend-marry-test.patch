+import { ApiProperty } from "@nestjs/swagger";
+import {
+  ArrayMaxSize,
+  ArrayMinSize,
+  Equals,
+  IsArray,
+  IsInt,
+  IsUUID,
+  Max,
+  Min,
+} from "class-validator";
+import { QUIZ_CONTRACT } from "./quiz-contract";
+
+export class CreateMarryTestResultDto {
+  @ApiProperty({
+    format: "uuid",
+    description: "한 번의 완료에 생성한 UUID. 재시도에는 같은 값 사용.",
+  })
+  @IsUUID("4")
+  submissionId!: string;
+
+  @ApiProperty({ enum: [QUIZ_CONTRACT.version] })
+  @Equals(QUIZ_CONTRACT.version)
+  quizVersion!: string;
+
+  @ApiProperty({
+    type: [Number],
+    minItems: 12,
+    maxItems: 12,
+    description: "v1 문항 순서대로 선택한 옵션 인덱스(0~3)",
+  })
+  @IsArray()
+  @ArrayMinSize(12)
+  @ArrayMaxSize(12)
+  @IsInt({ each: true })
+  @Min(0, { each: true })
+  @Max(3, { each: true })
+  answers!: number[];
+}
