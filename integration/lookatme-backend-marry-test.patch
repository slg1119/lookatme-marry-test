+/** Isolated local API runner. Loads only the real marry-test module; never reads production .env. */
+import "reflect-metadata";
+import { Module } from "@nestjs/common";
+import { NestFactory } from "@nestjs/core";
+import { MikroOrmModule } from "@mikro-orm/nestjs";
+import { MikroORM, PostgreSqlDriver } from "@mikro-orm/postgresql";
+import { Migrator } from "@mikro-orm/migrations";
+import { Migration20261026170000 } from "../migrations/Migration20261026170000";
+import { MarryTestModule } from "../src/marry-test/marry-test.module";
+import { MarryTestResult } from "../src/marry-test/entities/marry-test-result.entity";
+
+const clientUrl =
+  process.env.MARRY_TEST_DATABASE_URL ??
+  "postgresql://marry_test:marry_test_local@127.0.0.1:55478/marry_test";
+const url = new URL(clientUrl);
+if (
+  !["127.0.0.1", "localhost"].includes(url.hostname) ||
+  url.pathname !== "/marry_test"
+)
+  throw new Error("Local marry_test database only.");
+@Module({
+  imports: [
+    MikroOrmModule.forRoot({
+      driver: PostgreSqlDriver,
+      clientUrl,
+      entities: [MarryTestResult],
+      extensions: [Migrator],
+      debug: false,
+      migrations: { migrationsList: [Migration20261026170000] },
+    }),
+    MarryTestModule,
+  ],
+})
+class LocalMarryTestApp {}
+async function start() {
+  const app = await NestFactory.create(LocalMarryTestApp);
+  app.enableCors({
+    origin: ["http://localhost:4173", "http://127.0.0.1:4173"],
+  });
+  await app.init();
+  await app.get(MikroORM).getMigrator().up();
+  await app.listen(3017, "127.0.0.1");
+}
+void start();
