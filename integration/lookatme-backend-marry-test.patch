+import { scoreMarryTest } from "./marry-test.scoring";
+import { QUIZ_CONTRACT } from "./quiz-contract";
+
+describe("marry-v1 scoring contract", () => {
+  it.each(QUIZ_CONTRACT.profileIds.map((id, index) => [id, index] as const))(
+    "reaches %s independently of partner answers",
+    (id, index) => {
+      const self = [
+        index & 4 ? 3 : 0,
+        index & 2 ? 3 : 0,
+        index & 1 ? 3 : 0,
+      ].flatMap((v) => [v, v]);
+      for (const partner of [0, 3])
+        expect(
+          scoreMarryTest("marry-v1", [...self, ...Array(6).fill(partner)])
+            .profileId,
+        ).toBe(id);
+    },
+  );
+  it("preserves balanced axes and computes partner independently", () => {
+    expect(
+      scoreMarryTest("marry-v1", [0, 3, 0, 3, 0, 3, 3, 3, 0, 0, 1, 1]),
+    ).toEqual({
+      profileId: "everyday-soulmate",
+      self: { pace: 0, closeness: 0, care: 0 },
+      partner: { pace: 100, closeness: -100, care: -33 },
+    });
+  });
+  it.each(
+    [
+      [],
+      Array(11).fill(0),
+      Array(13).fill(0),
+      [4, ...Array(11).fill(0)],
+      [null, ...Array(11).fill(0)],
+      [1.5, ...Array(11).fill(0)],
+      ["1", ...Array(11).fill(0)],
+    ].map((answers) => [answers]),
+  )("rejects invalid answers %#", (answers) => {
+    expect(() => scoreMarryTest("marry-v1", answers as number[])).toThrow();
+  });
+  it("rejects unknown versions", () =>
+    expect(() => scoreMarryTest("marry-v2", Array(12).fill(0))).toThrow());
+});
