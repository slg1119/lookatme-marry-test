+import { randomUUID } from "node:crypto";
+import { ConflictException, Injectable } from "@nestjs/common";
+import { EntityManager } from "@mikro-orm/postgresql";
+import { CreateMarryTestResultDto } from "./marry-test.dto";
+import { MarryTestResult } from "./entities/marry-test-result.entity";
+import { scoreMarryTest } from "./marry-test.scoring";
+
+@Injectable()
+export class MarryTestService {
+  constructor(private readonly em: EntityManager) {}
+
+  async create(dto: CreateMarryTestResultDto) {
+    const result = scoreMarryTest(dto.quizVersion, dto.answers);
+    // A unique DB constraint also serializes simultaneous retries across server instances.
+    // Never overwrite a prior result when the same submission key has different answers.
+    await this.em.getConnection().execute(
+      `insert into marry_test_results
+        (id, submission_id, quiz_version, answers, profile_id, self_scores, partner_scores, created_at, updated_at)
+       values (?, ?, ?, ?::jsonb, ?, ?::jsonb, ?::jsonb, now(), now())
+       on conflict (submission_id) do nothing`,
+      [
+        randomUUID(),
+        dto.submissionId,
+        dto.quizVersion,
+        JSON.stringify(dto.answers),
+        result.profileId,
+        JSON.stringify(result.self),
+        JSON.stringify(result.partner),
+      ],
+    );
+    const saved = await this.em.findOneOrFail(
+      MarryTestResult,
+      { submissionId: dto.submissionId },
+      { refresh: true },
+    );
+    if (
+      saved.quizVersion !== dto.quizVersion ||
+      JSON.stringify(saved.answers) !== JSON.stringify(dto.answers)
+    ) {
+      throw new ConflictException(
+        "이미 저장된 제출 번호입니다. 새로운 테스트는 새 제출 번호를 사용해 주세요.",
+      );
+    }
+    return {
+      id: saved.id,
+      submissionId: saved.submissionId,
+      quizVersion: saved.quizVersion,
+      result: {
+        profileId: saved.profileId,
+        self: saved.selfScores,
+        partner: saved.partnerScores,
+      },
+      createdAt: saved.createdAt.toISOString(),
+    };
+  }
+}
