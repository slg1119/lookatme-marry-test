+import { Entity, Index, Property, Unique } from "@mikro-orm/core";
+import { BaseEntity } from "../../common/entities/base.entity";
+import type { AxisScores } from "../marry-test.scoring";
+
+@Entity({
+  tableName: "marry_test_results",
+  comment: "결혼 성향 테스트 익명 결과",
+})
+@Unique({
+  name: "marry_test_results_submission_id_unique",
+  properties: ["submissionId"],
+})
+@Index({
+  name: "marry_test_results_created_at_index",
+  properties: ["createdAt"],
+})
+export class MarryTestResult extends BaseEntity {
+  @Property({ type: "uuid", fieldName: "submission_id" })
+  submissionId!: string;
+
+  @Property({ fieldName: "quiz_version", length: 32 })
+  quizVersion!: string;
+
+  @Property({ type: "json" })
+  answers!: number[];
+
+  @Property({ fieldName: "profile_id", length: 64 })
+  profileId!: string;
+
+  @Property({ type: "json", fieldName: "self_scores" })
+  selfScores!: AxisScores;
+
+  @Property({ type: "json", fieldName: "partner_scores" })
+  partnerScores!: AxisScores;
+}
