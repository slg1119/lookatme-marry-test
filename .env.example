NEXT_PUBLIC_MEETING_URL=https://www.lookatme.my
# Server-only NestJS API origin. Required in production.
LOOKATME_API_URL=http://127.0.0.1:3017
# Required before public launch: HTTPS origin, without a path (then rebuild).
# When absent, localhost, preview, or SITE_NOINDEX=true, public indexing is off.
SITE_URL=
SITE_NOINDEX=false
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
