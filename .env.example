NEXT_PUBLIC_MEETING_URL=https://www.lookatme.my
# Kakao JavaScript key (client-side, not the REST/Admin key).
# Register https://test.lookatme.my as a JavaScript SDK and Product Link domain.
NEXT_PUBLIC_KAKAO_JS_KEY=
# Server-only NestJS API origin. Required in production.
LOOKATME_API_URL=http://127.0.0.1:3017
# Canonical HTTPS origin. Production builds default to this confirmed domain.
# Preview or SITE_NOINDEX=true disables indexing. Rebuild after changing this.
SITE_URL=https://test.lookatme.my
SITE_NOINDEX=false
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
